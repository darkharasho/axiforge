<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron requires these two for hardened runtime to allow the JS engine
       and native modules to run. Without them notarization passes but the
       app crashes on first launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- electron-updater downloads and runs updates from disk; the unsigned
       memory + DYLD env vars entitlements let the helper relaunch the new
       binary after hardened runtime validation. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- AxiForge talks to api.github.com, api.guildwars2.com, and the GW2
       wiki. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- File pickers for import/export of build .json / .axicode files. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>

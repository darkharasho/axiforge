{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axiforge-playground",
  // The Playground SPA + a small Worker for build-share short links. The Worker
  // handles /api/shorten, /api/b/<slug> and /b/<slug>; every other path is served
  // straight from the Vite build (./dist/web) as a static asset.
  "main": "workers/share-shortener/src/index.js",
  "compatibility_date": "2026-06-29",
  // @axiapps/code (used to validate share codes in the Worker) pulls in Buffer.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    // SPA fallback: unmatched paths return index.html so client routing works.
    "not_found_handling": "single-page-application",
    // Route ONLY these to the Worker. Without this, top-level navigations to
    // /b/<slug> (Sec-Fetch-Mode: navigate) would hit the SPA fallback and skip
    // the Worker entirely. Everything else is served as a static asset.
    "run_worker_first": ["/api/*", "/b/*"]
  },
  // slug -> { code, name } store for short links.
  "kv_namespaces": [
    {
      "binding": "SHARE_SLUGS",
      "id": "9de700fddbf44c3a9d271c8e7309a147",
      "preview_id": "b559de0fa5cb426bb5fa8456dc9a1380"
    },
    {
      "binding": "SYNC_RL",
      "id": "eaecf0c40e3f4f4eaa70e88549ec67e7",
      "preview_id": "742850a18fef492d8c81f9c73b76c37a"
    }
  ],
  // Team sync (workers/sync): D1 for teams/items, KV for rate-limit counters.
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "axiforge-sync",
      "database_id": "f5a42b9b-2a7c-4cde-ad82-57091eb73e37",
      "migrations_dir": "workers/sync/migrations"
    }
  ],
  // Workers Logs. Without this the Worker keeps no server-side record at all,
  // so a member reporting "my item won't sync" leaves nothing to look at — and
  // prod D1 is not reachable from here either. Sampling stays at 1 (keep
  // everything): this Worker's traffic is a handful of teams polling every 30s.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["0 4 * * *"] },
  // Custom domain — axi.link DNS is already on Cloudflare, so the first deploy
  // provisions build.axi.link + its DNS record.
  "routes": [{ "pattern": "build.axi.link", "custom_domain": true }]
}
